# Copie este arquivo para .env e preencha com seus dados reais.
# NUNCA commite o .env em git.

# 1) ID da sua conta Instagram Business (numérico, 17-18 dígitos)
IG_USER_ID=17841400000000000

# 2) Token de longa duração da Meta (60 dias, renove antes de expirar)
#    Gere em: https://developers.facebook.com/tools/explorer/
#    Troque por long-lived: https://graph.facebook.com/v21.0/oauth/access_token
META_ACCESS_TOKEN=EAAJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3) URL público onde estão hospedadas as PNGs em /criativos
#    Requer repo PÚBLICO (Instagram não autentica em repo privado)
MEDIA_BASE_URL=https://raw.githubusercontent.com/DevOpsRaizOficial/marketing/main/criativos
VIDEO_BASE_URL=https://raw.githubusercontent.com/DevOpsRaizOficial/marketing/main/videos_mp4

# 4) Caminhos dos recursos (relativos ao instagram_publisher.py)
CALENDAR_XLSX=../calendario-editorial-30-dias.xlsx
CREATIVES_DIR=../criativos

# ================================================================
# HeyGen API (plano Team ou Enterprise)
# ================================================================
# Pegue em: https://app.heygen.com/settings?nav=API
HEYGEN_API_KEY=hg_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Descubra rodando:  python heygen_client.py avatars
HEYGEN_AVATAR_ID=avatar_id_do_seu_avatar_Teste1
# Descubra rodando:  python heygen_client.py voices
HEYGEN_VOICE_ID=voice_id_da_voice_clone_Teste1

# ================================================================
# Storage público para vídeos (Meta Graph API exige URL público)
# Escolha um backend abaixo.
# ================================================================

# --- Opção 1 (recomendada): GitHub Releases ---
# Grátis, ilimitado, estável, não precisa de CDN.
# Crie um Personal Access Token em:
#   https://github.com/settings/tokens/new  (escopo: public_repo ou repo)
VIDEO_HOSTING=github
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=DevOpsRaizOficial/marketing

# --- Opção 2: Cloudflare R2 (S3-compatible) ---
# Use se quiser CDN próprio em cdn.devopsraiz.com.br, 10GB grátis
# VIDEO_HOSTING=r2
# R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# R2_ACCESS_KEY=xxx
# R2_SECRET_KEY=xxx
# R2_BUCKET=devopsraiz-ig
# R2_PUBLIC_URL=https://cdn.devopsraiz.com.br/ig

# Forçar regeneração de vídeos mesmo se MP4 já existir localmente
REGENERATE=false

# ================================================================
# Pipeline HeyGen Mateo + cenas Pixar (passo 5)
# ================================================================
# Avatar e voice clone EXCLUSIVOS do Mateo (separados do avatar genérico acima)
# Descubra rodando: python heygen_client.py avatars
HEYGEN_AVATAR_ID_MATEO=avatar_mateo_id_aqui
HEYGEN_VOICE_ID_MATEO=voice_mateo_id_aqui

# Backend para gerar imagens estilo Pixar das cenas [PIXAR: ...]
# Opções: replicate (padrão, SDXL ~US$ 0.003/imagem), openai (DALL-E ~US$ 0.04), stub (sem custo, placeholder laranja pra testar pipeline)
PIXAR_BACKEND=replicate
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Alternativa: OPENAI_API_KEY pra gpt-image-1 (DALL-E 3)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Trilha sonora de fundo (opcional) — mp3 royalty-free em assets/bgm.mp3
BGM_PATH=../assets/bgm.mp3

# ================================================================
# YouTube Data API v3 (canal @DevOpsRaiz)
# ================================================================
# Setup one-time:
#   1) https://console.cloud.google.com → criar projeto → habilitar YouTube Data API v3
#   2) Credentials → OAuth Client ID → Desktop App → baixar credentials.json
#   3) python get_youtube_token.py (autoriza no browser) → copia refresh_token aqui
YOUTUBE_CLIENT_ID=xxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
YOUTUBE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx
# IDs das playlists pra adicionar vídeos automaticamente (opcional)
# Crie em https://studio.youtube.com → Playlists
YOUTUBE_PLAYLIST_AULAS=PLxxxxxxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_PLAYLIST_SHORTS=PLxxxxxxxxxxxxxxxxxxxxxxxxxxxx
